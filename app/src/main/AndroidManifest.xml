<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Part 12 (Attack Surface Reduction): "Minimize exported components.
        Least privilege permissions. Disable unused capabilities."

        No permissions are declared in Milestone 1 because no feature that
        requires one (biometrics, camera for QR, file access for
        import/export) has been implemented yet. Permissions are added
        only in the milestone that actually consumes them.
    -->

    <!--
        Biometric quick-unlock: declared because the biometric feature is
        implemented (BiometricKeyManager). USE_BIOMETRIC is a normal
        permission — no runtime request needed.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".SecureVaultApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureVaultNext"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <!--
            allowBackup is explicitly false: SecureVault Next owns its own
            versioned, encrypted Backup Center (Part 4 / Part 12). The
            vault must never be silently included in an OS-managed cloud
            backup outside of that controlled, user-initiated flow.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SecureVaultNext.Splash"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
